{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-skill-pack.local/schemas/artifact-v0.1.json",
  "title": "Research Artifact Contract v0.1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "id", "type", "version", "created_at", "created_by", "status", "depends_on", "supersedes", "change_reason", "provenance", "verification_status", "manuscript_eligibility"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$"},
    "type": {"type": "string"},
    "version": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "created_by": {"enum": ["user", "skill", "import", "migration"]},
    "status": {"enum": ["draft", "confirmed", "verified", "advisory_only", "superseded", "rejected", "blocked"]},
    "depends_on": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,95}$"}},
    "supersedes": {"type": ["string", "null"]},
    "change_reason": {"type": "string", "minLength": 1},
    "provenance": {"enum": ["external_source", "user_supplied", "project_generated", "synthetic_fixture"]},
    "verification_status": {"enum": ["unreviewed", "ai_extracted", "human_verified", "rejected"]},
    "manuscript_eligibility": {"enum": ["not_eligible", "background_only", "claim_eligible"]},
    "raw_data": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "access", "truthfulness_declaration", "model_access"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "access": {"enum": ["restricted", "project_owner_only", "approved_deidentified_summary"]},
        "truthfulness_declaration": {"type": "string", "minLength": 1},
        "model_access": {"const": "forbidden_by_default"}
      }
    }
  }
}
